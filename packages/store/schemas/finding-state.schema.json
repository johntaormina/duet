{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:finding-state",
  "title": "finding-state",
  "$comment": "@spec ART-FIND-008",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "open",
              "dismissed",
              "fixed"
            ]
          }
        },
        "required": [
          "fingerprint",
          "state"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "states"
  ]
}