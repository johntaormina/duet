{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:recommendations",
  "title": "recommendations",
  "$comment": "@spec ART-LEAN-001",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1
          },
          "option": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "what_would_change_my_mind": {
            "type": "string",
            "minLength": 1
          },
          "card_hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "card_id",
          "option",
          "confidence",
          "reasoning",
          "what_would_change_my_mind",
          "card_hash"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "entries"
  ]
}