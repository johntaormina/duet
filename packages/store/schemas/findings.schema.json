{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:findings",
  "title": "findings",
  "$comment": "@spec ART-FIND-001, ART-FIND-002, ART-FIND-003, ART-FIND-004, ART-FIND-005",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "nit"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/anchor"
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "suggested_fix": {
            "type": "string"
          },
          "found_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_cards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "confirmed",
                  "refuted",
                  "uncertain"
                ]
              },
              "by": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "by",
              "notes"
            ]
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "confidence",
          "title",
          "anchors",
          "evidence",
          "found_by",
          "related_cards",
          "verification",
          "fingerprint"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reviewed",
        "skipped"
      ]
    },
    "exploration": {
      "type": "object",
      "properties": {
        "context_gathered": {
          "type": "string"
        },
        "budget": {
          "type": "string"
        },
        "not_examined": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "context_gathered",
        "budget",
        "not_examined"
      ]
    }
  },
  "required": [
    "schema_version",
    "findings",
    "coverage",
    "exploration"
  ]
}