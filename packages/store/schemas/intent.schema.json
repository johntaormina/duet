{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:intent",
  "title": "intent",
  "$comment": "@spec ART-ANCH-001, ART-ANCH-002, ART-BRIEF-001, ART-BRIEF-002",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "stated": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed": {
      "type": "string"
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/anchor"
            }
          },
          "kind": {
            "enum": [
              "contradiction",
              "unstated"
            ]
          }
        },
        "required": [
          "statement",
          "anchors",
          "kind"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "stated",
    "sources",
    "observed",
    "mismatches"
  ],
  "if": {
    "properties": {
      "stated": {
        "const": ""
      }
    }
  },
  "then": {
    "properties": {
      "sources": {
        "maxItems": 0
      }
    }
  }
}