                "string",
                "null"
              ]
            },
            "error": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "started_at",
            "finished_at",
            "cache_key"
          ],
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "error"
