          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "running",
                "complete",
                "failed"
              ]
            },
            "started_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "finished_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "cache_key": {
