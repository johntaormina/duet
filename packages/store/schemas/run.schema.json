{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:run",
  "title": "run",
  "$comment": "@spec ART-FILE-004, ART-STAGE-001, ART-STAGE-002, ART-STAGE-003, ART-STAGE-004, ART-STAGE-007",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "title": {
      "type": "string"
