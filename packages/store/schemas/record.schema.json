{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:record",
  "title": "record",
  "$comment": "@spec ART-LOG-002, ART-LOG-003, ART-LOG-004, ART-LOG-005, ART-LOG-006",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "incomplete_stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "card_hash": {
            "type": "string",
            "minLength": 1
          },
          "chosen_option": {
            "type": "integer",
            "minimum": 0
          },
          "rationale": {
            "type": "string"
          },
          "committed_at": {
            "type": "string",
            "minLength": 1
          },
          "revealed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "agreed_with_ai": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "integer"
                },
                "to": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "from",
                "to",
                "reason",
                "at"
              ]
            }
          },
          "previous": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "card_id",
          "fingerprint",
          "card_hash",
          "chosen_option",
          "rationale",
          "committed_at",
          "revealed_at",
          "agreed_with_ai",
          "changes"
        ]
      }
    },
    "posted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "text_hash": {
            "type": "string",
            "minLength": 1
          },
          "signed_off_at": {
            "type": "string",
            "minLength": 1
          },
          "posted_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target",
          "text_hash",
          "signed_off_at",
          "posted_at"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "reviewer",
    "started_at",
    "ended_at",
    "incomplete_stages",
    "answers",
    "posted"
  ]
}