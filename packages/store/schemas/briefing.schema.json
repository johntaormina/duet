{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duet:briefing",
  "title": "briefing",
  "$comment": "@spec ART-BRIEF-003, ART-BRIEF-004, ART-BRIEF-005, ART-BRIEF-006, ART-BRIEF-007, ART-BRIEF-009, ART-BRIEF-010",
  "definitions": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "binary": {
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "commit"
      ],
      "if": {
        "not": {
          "properties": {
            "binary": {
              "const": true
            }
          },
          "required": [
            "binary"
          ]
        }
      },
      "then": {
        "required": [
          "start_line",
          "end_line"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "effort": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "minutes": {
          "type": "number",
          "minimum": 0
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "score",
        "minutes",
        "drivers"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "reason"
            ]
          }
        }
      },
      "required": [
        "reviewed",
        "skipped"
      ]
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "files",
          "depends_on"
        ]
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/anchor"
            }
          }
        },
        "required": [
          "id",
          "title",
          "explanation",
          "anchors"
        ]
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "approach",
              "choice"
            ]
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "object",
            "properties": {
              "source": {
                "enum": [
                  "stated",
                  "inferred",
                  "none"
                ]
              },
              "text": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "text"
            ],
            "if": {
              "properties": {
                "source": {
                  "const": "stated"
                }
              }
            },
            "then": {
              "required": [
                "quote",
                "item"
              ]
            }
          },
          "anchors": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/anchor"
            }
          },
          "step_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "choice",
          "alternative",
          "tradeoff",
          "rationale",
          "anchors",
          "step_ref"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "effort",
    "coverage",
    "cohorts",
    "steps",
    "choices"
  ]
}